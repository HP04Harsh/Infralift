# Example environment variables (do NOT store secrets here)
DOCKER_USERNAME=
DOCKER_PASSWORD=
DOCKER_REPO_FRONTEND=yourdockerhubuser/infralift-frontend
DOCKER_REPO_BACKEND=yourdockerhubuser/infralift-backend

# App runtime env (example)
NEXT_PUBLIC_API_URL=https://api.example.com
DATABASE_URL=postgres://user:pass@db:5432/db
REDIS_URL=redis://redis:6379/0
